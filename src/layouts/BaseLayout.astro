---
import "@fontsource-variable/hanken-grotesk";
import "@fontsource-variable/space-grotesk";
import "@fontsource/jetbrains-mono";
// The two fonts on screen at first paint (name + body), preloaded so the hero doesn't swap fonts
import spaceGroteskLatin from "@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url";
import hankenGroteskLatin from "@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url";
import "../styles/global.css";
import { htmlLang, langFromLocale, ogLocale, pathIn, type Lang } from "../i18n";
// Cookie-free visit counts and real-user Core Web Vitals (enable both in the Vercel dashboard)
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";

export interface Props {
  title?: string;
  description?: string;
  /** Social preview image (1200x630) under public/, e.g. '/og/burgame.jpg' */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  /** Extra schema.org nodes for this page (e.g. BreadcrumbList); merged into the site-wide @graph */
  jsonLd?: Record<string, unknown>[];
  /** Keep the page out of search results (the 404) */
  noindex?: boolean;
}

const lang: Lang = langFromLocale(Astro.currentLocale);
const defaults = {
  es: {
    title: 'Giuliano Espejo Mezzabotta — Backend Developer Java',
    description: 'Giuliano Espejo Mezzabotta, Backend Developer Java. APIs con Spring Boot y PostgreSQL en proyectos reales de pagos, reservas y stock. Profesor en la UTN.',
    person: 'Backend Developer Java especializado en Spring Boot, PostgreSQL y APIs REST, con proyectos reales de pagos, reservas y stock. Profesor de Programación en la UTN.',
    disambiguation: 'Desarrollador Backend Java, Técnico Universitario en Programación por UTN. No está relacionado con la política. No es el diputado nacional.',
  },
  en: {
    title: 'Giuliano Espejo Mezzabotta — Java Backend Developer',
    description: 'Giuliano Espejo Mezzabotta, Java Backend Developer. Spring Boot and PostgreSQL APIs for real payments, bookings and stock projects. Programming teacher at UTN.',
    person: 'Java Backend Developer specialized in Spring Boot, PostgreSQL and REST APIs, with real projects in payments, bookings and stock. Programming teacher at UTN (Argentina).',
    disambiguation: 'Java Backend Developer, university programming technician from UTN (Argentina). Not related to politics. Not the national deputy.',
  },
}[lang];
const { title = defaults.title, description = defaults.description } = Astro.props;
const { image = lang === 'en' ? '/og/home-en.jpg' : '/og/home.jpg', imageAlt = 'Giuliano Espejo Mezzabotta — Backend Developer', type = 'website' } = Astro.props;
const ogImage = Astro.site ? new URL(image, Astro.site).href : image;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const homeUrl = Astro.site ? Astro.site.href : '/';
// The same page in each language, for hreflang
const alternates = (['es', 'en'] as Lang[]).map((l) => ({
  lang: l,
  href: Astro.site ? new URL(pathIn(Astro.url.pathname, l), Astro.site).href : pathIn(Astro.url.pathname, l),
}));
const { jsonLd = [] } = Astro.props;

// Stable ids so page-level nodes can point at the person/site (e.g. a project's author)
const personId = `${homeUrl}#person`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: 'Giuliano Espejo Mezzabotta',
      givenName: 'Giuliano',
      familyName: 'Espejo Mezzabotta',
      additionalName: 'Mezzabotta',
      disambiguatingDescription: defaults.disambiguation,
      jobTitle: 'Backend Developer',
      description: defaults.person,
      url: homeUrl.replace(/\/$/, ''),
      image: new URL('/og/home.jpg', homeUrl).href,
      sameAs: [
        'https://github.com/Giuliano-Espejo',
        'https://www.linkedin.com/in/giuliano-espejo-mezzabotta',
      ],
      email: 'espejogiuliano@gmail.com',
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universidad Tecnológica Nacional' },
      knowsAbout: ['Java', 'Spring Boot', 'Spring Security', 'SQL', 'PostgreSQL', 'Microservices', 'Linux', 'CI/CD', 'Backend Development', 'REST APIs', 'JPA/Hibernate', 'Flyway', 'WebSocket', 'JWT', 'Docker', 'Mercado Pago API', 'Python', 'FastAPI'],
    },
    {
      '@type': 'WebSite',
      '@id': `${homeUrl}#website`,
      url: homeUrl,
      name: 'Giuliano Espejo Mezzabotta — Backend Developer',
      inLanguage: ['es-AR', 'en-US'],
      publisher: { '@id': personId },
    },
    ...jsonLd,
  ],
};
---

<!doctype html>
<html lang={htmlLang[lang]} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" href={spaceGroteskLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={hankenGroteskLatin} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    {Astro.props.noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Canonical URL -->
    {!Astro.props.noindex && (
      <>
        <link rel="canonical" href={canonicalUrl} />
        {alternates.map((a) => <link rel="alternate" hreflang={htmlLang[a.lang]} href={a.href} />)}
        <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
      </>
    )}

    <!-- Open Graph / Social sharing -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={imageAlt} />
    {!Astro.props.noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Giuliano Espejo Mezzabotta" />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[lang === 'es' ? 'en' : 'es']} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- JSON-LD structured data: Person + WebSite on every page, plus page-specific nodes -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <meta name="theme-color" content="#0a0b10" />

    <Analytics />
    <SpeedInsights />

    <!-- The `js` class gates the scroll animations so content stays visible without JS -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="min-h-screen antialiased">
    <a href="#contenido" class="skip-link">{lang === 'en' ? 'Skip to content' : 'Saltar al contenido'}</a>
    <slot />
  </body>
</html>

<script>
  // Scroll-triggered animations via Intersection Observer
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    // threshold 0: any overlap counts, so elements taller than 10 viewports still reveal
    { threshold: 0, rootMargin: '0px 0px -8% 0px' }
  );

  document.querySelectorAll('.animate-section, .animate-card, .reveal-heading').forEach((el) => {
    observer.observe(el);
  });

  // Highlight the nav link of the section currently in view
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
  const sectionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        navLinks.forEach((link) => {
          if (link.hash === `#${entry.target.id}`) {
            link.setAttribute('aria-current', 'true');
          } else {
            link.removeAttribute('aria-current');
          }
        });
      });
    },
    { rootMargin: '-40% 0px -55% 0px' }
  );

  document.querySelectorAll('main section[id]').forEach((section) => {
    sectionObserver.observe(section);
  });

  // Scroll-linked effects, batched into one rAF per frame:
  // header progress bar and the experience timeline fill
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const progressBar = document.querySelector<HTMLElement>('[data-scroll-progress]');
  // Dot offsets are measured once (and when the list changes size), not on every scroll frame
  const timelines = [...document.querySelectorAll<HTMLElement>('[data-timeline]')].map((el) => ({
    el,
    dots: [...el.querySelectorAll<HTMLElement>('.timeline-dot')],
    offsets: [] as number[],
  }));
  const measureTimelines = () => {
    timelines.forEach((t) => {
      const top = t.el.getBoundingClientRect().top;
      t.offsets = t.dots.map((dot) => dot.getBoundingClientRect().top - top);
    });
  };

  const clamp = (n: number) => Math.min(Math.max(n, 0), 1);

  function update() {
    const y = window.scrollY;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    // Set on the header so the bar and the little plane riding it share the value
    (progressBar?.parentElement ?? progressBar)?.style.setProperty('--progress', max > 0 ? (y / max).toFixed(4) : '0');

    if (reduceMotion) return;

    timelines.forEach(({ el, dots, offsets }) => {
      const rect = el.getBoundingClientRect(); // one layout read per timeline
      // The line fills as the timeline passes the middle of the viewport
      const progress = clamp((window.innerHeight * 0.55 - rect.top) / rect.height);
      el.style.setProperty('--progress', progress.toFixed(4));
      const filled = progress * rect.height;
      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', (offsets[i] ?? 0) <= filled);
      });
    });
  }

  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      update();
      ticking = false;
    });
  };

  if (reduceMotion) {
    timelines.forEach(({ dots }) => dots.forEach((dot) => dot.classList.add('is-active')));
  } else {
    measureTimelines();
    // Re-measure when a timeline changes size (fonts loading, "Ver las N misiones")
    const ro = new ResizeObserver(() => { measureTimelines(); onScroll(); });
    timelines.forEach(({ el }) => ro.observe(el));
  }
  update();
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
</script>
