---
import "@fontsource-variable/inter";
import "@fontsource-variable/space-grotesk";
import "@fontsource/jetbrains-mono";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  /** Social preview image (1200x630) under public/, e.g. '/og/burgame.jpg' */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
}

const { title = 'Giuliano Espejo Mezzabotta — Java Backend Developer | Portfolio', description = 'Portfolio profesional de Giuliano Espejo Mezzabotta, Desarrollador Backend Java especializado en Spring Boot, PostgreSQL y APIs REST. Técnico Universitario en Programación - UTN.' } = Astro.props;
const { image = '/og/home.jpg', imageAlt = 'Giuliano Espejo Mezzabotta — Backend Developer', type = 'website' } = Astro.props;
const ogImage = Astro.site ? new URL(image, Astro.site).href : image;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const homeUrl = Astro.site ? Astro.site.href : '/';
---

<!doctype html>
<html lang="es" class="">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Social sharing -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Giuliano Espejo Mezzabotta" />
    <meta property="og:locale" content="es_AR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- JSON-LD Structured Data (Person) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Giuliano Espejo Mezzabotta",
        "givenName": "Giuliano",
        "familyName": "Espejo Mezzabotta",
        "additionalName": "Mezzabotta",
        "disambiguatingDescription": "Desarrollador Backend Java, Técnico Universitario en Programación por UTN. No está relacionado con la política. No es el diputado nacional.",
        "jobTitle": "Java Backend Developer",
        "description": "Portfolio profesional de Giuliano Espejo Mezzabotta. Desarrollador Backend Java especializado en Spring Boot, PostgreSQL, JPA/Hibernate, APIs REST y WebSockets. Actualmente Profesor de Programación en UTN.",
        "url": {JSON.stringify(homeUrl.replace(/\/$/, ''))},
        "sameAs": [
          "https://github.com/Giuliano-Espejo",
          "https://www.linkedin.com/in/giuliano-espejo-mezzabotta"
        ],
        "email": "espejogiuliano@gmail.com",
        "telephone": "+54 9 261 251 5732",
        "alumniOf": {
          "@type": "CollegeOrUniversity",
          "name": "Universidad Tecnológica Nacional"
        },
        "knowsAbout": ["Java", "Spring Boot", "Spring Security", "PostgreSQL", "Backend Development", "REST APIs", "JPA/Hibernate", "Flyway", "WebSocket", "JWT", "Docker", "Mercado Pago API", "Python", "FastAPI"]
      }
    </script>

    <meta name="theme-color" content="#f4f4f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />

    <!-- Theme flash prevention — runs before first paint.
         The `js` class gates the scroll animations so content stays visible without JS. -->
    <script is:inline>
      (function() {
        const root = document.documentElement;
        root.classList.add('js');
        let theme = null;
        try { theme = localStorage.getItem('theme'); } catch (e) {}
        theme = theme ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        root.classList.toggle('dark', theme === 'dark');
      })();
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <!-- Decorative background: drifting blue glows + film grain -->
    <div class="aurora" aria-hidden="true">
      <div class="aurora-layer" data-parallax="0.15"><div class="aurora-blob aurora-blob--1"></div></div>
      <div class="aurora-layer" data-parallax="-0.1"><div class="aurora-blob aurora-blob--2"></div></div>
      <div class="aurora-layer" data-parallax="0.25"><div class="aurora-blob aurora-blob--3"></div></div>
    </div>
    <div class="grain" aria-hidden="true"></div>
    <slot />
  </body>
</html>

<script>
  // Scroll-triggered animations via Intersection Observer
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    // threshold 0: any overlap counts, so elements taller than 10 viewports still reveal
    { threshold: 0, rootMargin: '0px 0px -8% 0px' }
  );

  document.querySelectorAll('.animate-section, .animate-card, .reveal-heading').forEach((el) => {
    observer.observe(el);
  });

  // Highlight the nav link of the section currently in view
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
  const sectionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        navLinks.forEach((link) => {
          if (link.hash === `#${entry.target.id}`) {
            link.setAttribute('aria-current', 'true');
          } else {
            link.removeAttribute('aria-current');
          }
        });
      });
    },
    { rootMargin: '-40% 0px -55% 0px' }
  );

  document.querySelectorAll('main section[id]').forEach((section) => {
    sectionObserver.observe(section);
  });

  // Scroll-linked effects, batched into one rAF per frame:
  // header progress bar, background parallax and the experience timeline fill
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const progressBar = document.querySelector<HTMLElement>('[data-scroll-progress]');
  const parallaxLayers = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
  const timelines = [...document.querySelectorAll<HTMLElement>('[data-timeline]')].map((el) => ({
    el,
    dots: [...el.querySelectorAll<HTMLElement>('.timeline-dot')],
  }));

  const clamp = (n: number) => Math.min(Math.max(n, 0), 1);

  function update() {
    const y = window.scrollY;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    progressBar?.style.setProperty('--progress', max > 0 ? (y / max).toFixed(4) : '0');

    if (reduceMotion) return;

    parallaxLayers.forEach((layer) => {
      const speed = Number(layer.dataset.parallax);
      layer.style.transform = `translate3d(0, ${(y * speed * -1).toFixed(1)}px, 0)`;
    });

    timelines.forEach(({ el, dots }) => {
      const rect = el.getBoundingClientRect();
      // The line fills as the timeline passes the middle of the viewport
      const progress = clamp((window.innerHeight * 0.55 - rect.top) / rect.height);
      el.style.setProperty('--progress', progress.toFixed(4));
      const filled = rect.top + progress * rect.height;
      dots.forEach((dot) => {
        dot.classList.toggle('is-active', dot.getBoundingClientRect().top <= filled);
      });
    });
  }

  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      update();
      ticking = false;
    });
  };

  if (reduceMotion) {
    timelines.forEach(({ dots }) => dots.forEach((dot) => dot.classList.add('is-active')));
  }
  update();
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
</script>
