---
import ThemeToggle from './ThemeToggle.astro';

const navLinks = [
  { href: '/#sobre-mi', label: 'Sobre mí' },
  { href: '/#experiencia', label: 'Experiencia' },
  { href: '/#proyectos', label: 'Proyectos' },
  { href: '/#skills', label: 'Skills' },
  { href: '/#contacto', label: 'Contacto' },
];
---

<header class="sticky top-0 z-50 bg-[color-mix(in_srgb,var(--color-bg-primary)_70%,transparent)] backdrop-blur-md border-b border-[var(--color-border)]">
  <div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>
  <nav class="relative max-w-4xl mx-auto px-4 h-16 flex items-center justify-between" aria-label="Principal">
    <a href="/" class="font-mono font-semibold text-lg text-[var(--color-text-primary)] hover:text-[var(--color-accent)] transition-colors">
      <span class="text-gradient">GE</span><span class="text-[var(--color-text-secondary)]">.</span>
    </a>
    <div class="flex items-center gap-1 md:gap-4">
      <!-- One list for every screen: inline on desktop, native popover dropdown on mobile (no JS needed) -->
      <ul id="site-nav" popover class="site-nav">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              data-nav-link
              class="text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] aria-[current=true]:text-[var(--color-accent)] transition-colors"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <ThemeToggle />
      <button
        type="button"
        popovertarget="site-nav"
        class="site-nav-toggle md:hidden p-2 rounded-lg hover:bg-[var(--color-border)] transition-colors cursor-pointer"
        aria-label="Abrir menú"
      >
        <svg class="icon-open w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
        <svg class="icon-close w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </div>
  </nav>
</header>

<script>
  // Close the mobile dropdown after choosing a section
  const menu = document.getElementById('site-nav');
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      if (menu.matches(':popover-open')) menu.hidePopover();
    });
  });
</script>
