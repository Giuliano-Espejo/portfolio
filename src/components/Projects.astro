---
import ProjectCard from './ProjectCard.astro';
import SectionHeading from './SectionHeading.astro';

import donInodorosImg from '../assets/projects/don-inodoros.png';
import burgameImg from '../assets/projects/burgame.png';
import pastaFiorellaImg from '../assets/projects/pasta-fiorella.png';
import { langFromLocale, localize } from '../i18n';

// Card copy comes from each case study's frontmatter, in the page's language
interface CaseFrontmatter { title: string; teaser: string; imageAlt?: string; demos: { label: string; href: string }[] }
const lang = langFromLocale(Astro.currentLocale);
const studies = lang === 'en'
  ? import.meta.glob<{ frontmatter: CaseFrontmatter }>('../case-studies/en/*.md', { eager: true })
  : import.meta.glob<{ frontmatter: CaseFrontmatter }>('../case-studies/*.md', { eager: true });
const fm = (slug: string) => Object.entries(studies).find(([p]) => p.endsWith(`/${slug}.md`))![1].frontmatter;
const donInodoros = fm('don-inodoros');
const burgame = fm('burgame');
const pastaFiorella = fm('pasta-fiorella');
const en = lang === 'en';
const t = en
  ? { title: 'Projects', tag: 'Beacon 03 // Systems in production', gaming: 'Gaming bookings', orders: 'Online orders', site: 'Site', store: 'Store', dashboard: 'Dashboard' }
  : { title: 'Proyectos', tag: 'Baliza 03 // Sistemas en producción', gaming: 'Reservas gaming', orders: 'Pedidos online', site: 'Sitio', store: 'Tienda', dashboard: 'Dashboard' };

// To add a screenshot: put it in src/assets/projects/, import it and pass `image` (+ `imageAlt`).
// `repo` adds a "Código ↗" link; `caseStudy` links to an internal write-up page.
const projects = [
  {
    title: donInodoros.title,
    description: donInodoros.teaser,
    tags: ['Java 21', 'Spring Boot 4', 'Spring Security', 'PostgreSQL', 'Flyway', 'WebSocket', 'Docker'],
    image: donInodorosImg,
    imageAlt: donInodoros.imageAlt,
    caseStudy: localize('/proyectos/don-inodoros', lang),
  },
  {
    title: `${burgame.title} — ${t.gaming}`,
    description: burgame.teaser,
    tags: ['Java 21', 'Spring Boot 3.5', 'Spring Security', 'PostgreSQL', 'Mercado Pago', 'Docker'],
    image: burgameImg,
    imageAlt: burgame.imageAlt,
    caseStudy: localize('/proyectos/burgame', lang),
    link: burgame.demos[0].href,
    linkLabel: t.site,
  },
  {
    title: `${pastaFiorella.title} — ${t.orders}`,
    description: pastaFiorella.teaser,
    tags: ['Java 17', 'Spring Boot 3', 'PostgreSQL', 'Mercado Pago', 'Docker', 'json-server'],
    image: pastaFiorellaImg,
    imageAlt: pastaFiorella.imageAlt,
    caseStudy: localize('/proyectos/pasta-fiorella', lang),
    link: pastaFiorella.demos[0].href,
    linkLabel: t.store,
    links: [{ label: t.dashboard, href: pastaFiorella.demos[1].href }],
  },
];
---

<section id="proyectos" class="max-w-4xl mx-auto px-4 py-12">
  <SectionHeading index="03" title={t.title} tag={t.tag} />
  <div class="projects-track grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {projects.map((project, i) => (
      <div class="animate-card"><ProjectCard {...project} variant={i} /></div>
    ))}
  </div>
</section>
