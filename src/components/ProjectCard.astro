---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Tag from './Tag.astro';

export interface Props {
  title: string;
  description: string;
  tags: string[];
  /** Screenshot or diagram. Without it the card shows a generated cover. */
  image?: ImageMetadata;
  imageAlt?: string;
  link?: string;
  linkLabel?: string;
  repo?: string;
  /** Extra external links (e.g. a second demo), shown after `link` */
  links?: { label: string; href: string }[];
  /** Internal page with the full write-up; opens in the same tab */
  caseStudy?: string;
  /** Picks one of the cover gradients */
  variant?: number;
}

const { title, description, tags, image, imageAlt, link, linkLabel, links = [], repo, caseStudy, variant = 0 } = Astro.props;

// Generated covers: each card gets its own mix of the blue spectrum
const covers = [
  'radial-gradient(circle at 20% 20%, var(--g1), transparent 60%), radial-gradient(circle at 85% 80%, var(--g3), transparent 55%)',
  'radial-gradient(circle at 80% 15%, var(--g2), transparent 60%), radial-gradient(circle at 15% 90%, var(--g1), transparent 55%)',
  'radial-gradient(circle at 50% 110%, var(--g3), transparent 60%), radial-gradient(circle at 10% 10%, var(--g2), transparent 50%)',
];
const cover = covers[variant % covers.length];
const initials = title.split(/\s+/).filter(w => /^[A-Za-zÁÉÍÓÚ]/.test(w)).slice(0, 2).map(w => w[0]).join('');
---

<article class="card gradient-border group hover:-translate-y-1 transition-transform duration-300 flex flex-col h-full">
  <div class="relative aspect-[16/9] overflow-hidden rounded-t-[inherit] border-b border-[var(--color-border)] bg-[var(--color-bg-secondary)]">
    {image ? (
      <Image src={image} alt={imageAlt ?? title} widths={[400, 800]} sizes="(min-width: 1024px) 280px, (min-width: 768px) 50vw, 100vw" class="h-full w-full object-cover object-top transition-transform duration-700 group-hover:scale-105" />
    ) : (
      <>
        <div class="absolute inset-0 opacity-70 transition-transform duration-700 group-hover:scale-110" style={`background: ${cover}`} aria-hidden="true"></div>
        <div class="bg-grid absolute inset-0 opacity-50" aria-hidden="true"></div>
        <div class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
          <span class="font-display text-5xl font-bold text-white/90 drop-shadow-lg transition-transform duration-500 group-hover:scale-110">{initials}</span>
        </div>
        <span class="absolute bottom-3 left-3 px-2 py-0.5 rounded-md bg-black/30 backdrop-blur font-mono text-[11px] text-white/85" aria-hidden="true">{tags[0]}</span>
      </>
    )}
  </div>
  <div class="p-6 flex flex-col flex-1">
    <h3 class="text-lg font-semibold text-[var(--color-text-primary)] mb-2">{title}</h3>
    <p class="text-[var(--color-text-secondary)] text-sm leading-relaxed mb-4 flex-1">{description}</p>
    <div class="flex flex-wrap gap-1.5 mb-4" data-stagger>
      {tags.map((tag, i) => <Tag index={i}>{tag}</Tag>)}
    </div>
    {(caseStudy || link || links.length > 0 || repo) && (
      <div class="flex flex-wrap gap-x-4 gap-y-2">
        {caseStudy && (
          <a href={caseStudy} class="text-sm text-[var(--color-accent)] hover:underline font-medium">
            Ver caso completo →
          </a>
        )}
        {link && (
          <a href={link} target="_blank" rel="noopener noreferrer" class="text-sm text-[var(--color-accent)] hover:underline font-medium">
            {linkLabel || 'Ver proyecto'} ↗
          </a>
        )}
        {links.map(extra => (
          <a href={extra.href} target="_blank" rel="noopener noreferrer" class="text-sm text-[var(--color-accent)] hover:underline font-medium">
            {extra.label} ↗
          </a>
        ))}
        {repo && (
          <a href={repo} target="_blank" rel="noopener noreferrer" class="text-sm text-[var(--color-accent)] hover:underline font-medium">
            Código ↗
          </a>
        )}
      </div>
    )}
  </div>
</article>
