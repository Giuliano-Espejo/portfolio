---
import { Image } from 'astro:assets';
import profileImage from '../assets/profile.webp';

const firstName = ['Giuliano'];
const lastName = ['Espejo', 'Mezzabotta'];
const role = 'Backend Developer';
---

<section class="relative">
  <div class="bg-grid absolute inset-0 -z-10 opacity-60" aria-hidden="true"></div>
  <div class="max-w-4xl mx-auto px-4 min-h-[calc(100svh-4rem)] flex flex-col justify-center py-12 md:py-20">
    <div class="w-full flex flex-col md:flex-row items-center gap-10 md:gap-14">
      <div class="flex-shrink-0 hero-fade" style="--delay: 100ms">
        <div class="photo-ring">
          <Image
            src={profileImage}
            alt="Giuliano Espejo Mezzabotta"
            widths={[128, 192, 384]}
            sizes="(min-width: 768px) 192px, 128px"
            loading="eager"
            fetchpriority="high"
            class="relative w-32 h-32 md:w-48 md:h-48 rounded-full object-cover border-4 border-[var(--color-bg-primary)]"
          />
        </div>
      </div>

      <div class="text-center md:text-left flex-1">
        <p class="hero-fade inline-flex items-center gap-2 mb-6 px-3 py-1 rounded-full text-xs font-medium border border-[var(--color-border)] bg-[var(--color-card-bg)] text-[var(--color-text-secondary)] backdrop-blur" style="--delay: 50ms">
          <span class="relative flex h-2 w-2" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full rounded-full bg-[var(--color-success)] opacity-75 motion-safe:animate-ping"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-[var(--color-success)]"></span>
          </span>
          Disponible para proyectos freelance
        </p>

        <h1 class="text-5xl md:text-7xl font-bold tracking-tight leading-[1.02] text-[var(--color-text-primary)] mb-5" aria-label="Giuliano Espejo Mezzabotta">
          <span aria-hidden="true">
            {firstName.map((word, i) => (
              <span class="reveal-word"><span style={`--i: ${i}`}>{word}</span></span>
            ))}
            <br />
            {lastName.map((word, i) => (
              <>
                <span class="reveal-word"><span class="text-gradient text-gradient--animated" style={`--i: ${i + firstName.length}`}>{word}</span></span>{' '}
              </>
            ))}
          </span>
        </h1>

        <p class="hero-fade font-mono text-lg md:text-xl text-[var(--color-text-secondary)] mb-5" style="--delay: 450ms">
          <span class="text-[var(--color-highlight)]" aria-hidden="true">&gt;</span>
          <span class="sr-only">{role}</span>
          <!-- Invisible copy reserves the full width so centered text doesn't jitter while typing -->
          <span class="inline-grid text-left align-bottom text-[var(--color-text-primary)]" aria-hidden="true">
            <span class="invisible col-start-1 row-start-1">{role}<span class="typewriter-caret"></span></span>
            <span class="col-start-1 row-start-1"><span data-typewriter>{role}</span><span class="typewriter-caret"></span></span>
          </span>
        </p>

        <p class="hero-fade text-[var(--color-text-secondary)] text-lg max-w-lg mx-auto md:mx-0 mb-8" style="--delay: 550ms">
          Técnico Universitario en Programación. Especializado en Spring Boot, APIs REST y PostgreSQL.
          Actualmente Profesor de Programación en UTN.
        </p>

        <div class="hero-fade flex flex-wrap items-center gap-3 justify-center md:justify-start" style="--delay: 650ms">
          <a href="#proyectos" class="btn-gradient px-6 py-2.5 rounded-lg font-medium">
            Ver proyectos
          </a>
          <a href="/Giuliano_Espejo_CV.pdf" download="Giuliano_Espejo_CV.pdf" class="inline-flex items-center gap-2 px-6 py-2.5 border border-[var(--color-border)] bg-[var(--color-card-bg)] backdrop-blur text-[var(--color-text-primary)] rounded-lg hover:border-[var(--color-accent)] transition-colors font-medium">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
            Descargar CV
          </a>
          <div class="flex items-center gap-1 sm:ml-2">
            <a href="https://github.com/Giuliano-Espejo" target="_blank" rel="noopener noreferrer" class="p-2.5 rounded-lg text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:bg-[var(--color-card-bg)] transition-colors" aria-label="GitHub">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            </a>
            <a href="https://www.linkedin.com/in/giuliano-espejo-mezzabotta" target="_blank" rel="noopener noreferrer" class="p-2.5 rounded-lg text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:bg-[var(--color-card-bg)] transition-colors" aria-label="LinkedIn">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <a href="#sobre-mi" class="hero-fade hidden md:flex flex-col items-center gap-3 mx-auto mt-16 font-mono text-[11px] uppercase tracking-[0.25em] text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors" style="--delay: 900ms">
      Scroll
      <span class="relative block h-10 w-px bg-[var(--color-border)] overflow-hidden" aria-hidden="true">
        <span class="scroll-cue-line absolute inset-0 bg-gradient-to-b from-[var(--g1)] to-[var(--g3)]"></span>
      </span>
    </a>
  </div>
</section>

<script>
  // Typewriter: type the role, hold 5 s, delete right to left, repeat.
  // The full text is server-rendered, so it stays readable without JS or with reduced motion.
  const TYPE_MS = 90;
  const DELETE_MS = 50;
  const HOLD_MS = 5000;
  const PAUSE_MS = 600;
  const START_DELAY_MS = 700; // let the hero fade-in finish first

  const target = document.querySelector<HTMLElement>('[data-typewriter]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (target && !reduceMotion) {
    const text = target.textContent ?? '';
    const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

    const run = async () => {
      target.textContent = '';
      await sleep(START_DELAY_MS);
      while (true) {
        for (let i = 1; i <= text.length; i++) {
          target.textContent = text.slice(0, i);
          await sleep(TYPE_MS);
        }
        await sleep(HOLD_MS);
        for (let i = text.length - 1; i >= 0; i--) {
          target.textContent = text.slice(0, i);
          await sleep(DELETE_MS);
        }
        await sleep(PAUSE_MS);
      }
    };

    run();
  }
</script>
