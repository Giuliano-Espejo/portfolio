---
import SectionHeading from './SectionHeading.astro';
import Tag from './Tag.astro';

const experiences = [
  {
    role: 'Profesor de Programación',
    company: 'Universidad Tecnológica Nacional — Facultad Regional Mendoza',
    start: 'Ago 2025',
    current: true,
    achievements: [
      'Profesor de Programación 3 y Programación 4',
      'Dictado de desarrollo backend con Spring Boot y FastAPI',
      'Fundamentos de HTTP y APIs REST',
      'Tutor del pre-universitario (2024)',
    ],
    tags: ['Java', 'Spring Boot', 'Python', 'FastAPI', 'Alembic', 'HTTP', 'Docencia'],
  },
  {
    role: 'Tutor de Programación',
    company: 'Universidad Tecnológica Nacional — Facultad Regional San Nicolás',
    start: 'Ago 2025',
    current: true,
    achievements: [
      'Tutor de Programación 2 y Programación 3',
      'Acompañamiento en desarrollo backend con Spring Boot y FastAPI',
      'Fundamentos de HTTP y APIs REST',
    ],
    tags: ['Java', 'Spring Boot', 'Python', 'FastAPI', 'HTTP', 'Docencia'],
  },
  {
    role: 'Desarrollador Backend — Don Inodoros',
    company: 'Freelance',
    start: 'Jun 2026',
    end: 'Jul 2026',
    achievements: [
      'Sistema POS multi-sucursal para una distribuidora',
      'Stock por sucursal con validación transaccional',
      'Módulo de usuarios con roles y sucursales',
      'WebSocket con SockJS para alertas en tiempo real',
      'Suite de tests de integración con MockMvc',
    ],
    tags: ['Java 21', 'Spring Boot 4', 'Spring Security', 'PostgreSQL', 'Flyway', 'WebSocket', 'Docker'],
    caseStudy: '/proyectos/don-inodoros',
  },
  {
    role: 'Desarrollador Backend — BurGame',
    company: 'Freelance',
    start: 'Feb 2026',
    end: 'Abr 2026',
    achievements: [
      'Sistema de reservas online para centro de gaming',
      'API REST documentada con OpenAPI y autenticación JWT',
      'Integración con Mercado Pago para señas',
      'Validación de disponibilidad en tiempo real',
      'Panel administrativo con control de reservas',
    ],
    tags: ['Java 21', 'Spring Boot', 'JWT', 'Mercado Pago', 'PostgreSQL', 'Docker'],
    link: 'https://www.burgame.com',
    caseStudy: '/proyectos/burgame',
  },
  {
    role: 'Desarrollador Backend — Pasta Fiorella',
    company: 'Freelance',
    start: 'Mar 2025',
    end: 'Ago 2025',
    achievements: [
      'Backend de una plataforma de pedidos online',
      'API REST por capas para tienda y panel multi-sucursal',
      'Pagos con Mercado Pago confirmados por webhook',
      'Costo de envío calculado por distancia',
      'API mock con json-server para la demo pública',
    ],
    tags: ['Java 17', 'Spring Boot 3', 'JPA/Hibernate', 'PostgreSQL', 'Mercado Pago', 'Docker'],
    caseStudy: '/proyectos/pasta-fiorella',
  },
  {
    role: 'Desarrollador Backend (pasantía)',
    company: 'Semillero Latam',
    start: 'Jul 2023',
    end: 'Feb 2024',
    achievements: [
      'APIs para bolsa de trabajo',
      'APIs para E-Commerce',
      'Autenticación JWT y Google OAuth2',
      'Algoritmos de estadísticas y reporting',
    ],
    tags: ['Java', 'Spring Boot', 'JWT', 'OAuth2', 'REST APIs'],
  },
];
---

<section id="experiencia" class="max-w-4xl mx-auto px-4 py-12">
  <SectionHeading index="02" title="Experiencia" />
  <ol class="timeline ml-2 space-y-8" data-timeline>
    {experiences.map(exp => (
      <li class="relative pl-8 md:pl-10">
        <span class="timeline-dot" aria-hidden="true"></span>
        <div class="card gradient-border p-6 animate-card">
          <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-1 mb-1">
            <h3 class="text-lg font-semibold text-[var(--color-text-primary)]">{exp.role}</h3>
            <p class="font-mono text-xs text-[var(--color-text-secondary)] whitespace-nowrap">
              {exp.start} — {exp.current
                ? <span class="ml-1 px-2 py-0.5 rounded-full font-sans font-medium bg-[var(--color-highlight-soft)] text-[var(--color-highlight)]">Actual</span>
                : exp.end}
            </p>
          </div>
          <p class="font-medium text-[var(--color-accent)] mb-3">{exp.company}</p>
          <ul class="list-disc pl-5 marker:text-[var(--color-accent)] text-[var(--color-text-secondary)] space-y-1 mb-4">
            {exp.achievements.map(a => <li>{a}</li>)}
          </ul>
          <div class="flex flex-wrap gap-2" data-stagger>
            {exp.tags.map((tag, i) => <Tag index={i}>{tag}</Tag>)}
          </div>
          {(exp.caseStudy || exp.link) && (
            <div class="flex flex-wrap gap-x-4 gap-y-2 mt-4">
              {exp.caseStudy && (
                <a href={exp.caseStudy} class="text-sm font-medium text-[var(--color-accent)] hover:underline">
                  Ver caso completo<span class="sr-only"> de {exp.role.split(' — ')[1]}</span> →
                </a>
              )}
              {exp.link && (
                <a href={exp.link} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-[var(--color-accent)] hover:underline">
                  Ver sitio<span class="sr-only"> de {exp.role.split(' — ')[1]}</span> ↗
                </a>
              )}
            </div>
          )}
        </div>
      </li>
    ))}
  </ol>
</section>
