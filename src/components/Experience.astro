---
import SectionHeading from './SectionHeading.astro';
import Tag from './Tag.astro';
import { langFromLocale, localize } from '../i18n';

const lang = langFromLocale(Astro.currentLocale);
const L = <T,>(es: T, en: T) => (lang === 'en' ? en : es);
const t = L(
  { title: 'Experiencia', tag: 'Baliza 02 // Trayectoria', current: 'Actual', caseStudy: 'Ver caso completo', site: 'Ver sitio', of: 'de', more: (n: number) => `Ver las ${n} misiones` },
  { title: 'Experience', tag: 'Beacon 02 // Track record', current: 'Current', caseStudy: 'Read the case study', site: 'Visit site', of: 'for', more: (n: number) => `See all ${n} missions` },
);

const experiences = [
  {
    role: L('Profesor de Programación', 'Programming Teacher'),
    company: L('Universidad Tecnológica Nacional — Facultad Regional Mendoza', 'Universidad Tecnológica Nacional (UTN) — Mendoza'),
    start: L('Ago 2025', 'Aug 2025'),
    current: true,
    achievements: L(
      ['Profesor de Programación 3 y Programación 4', 'Dictado de desarrollo backend con Spring Boot y FastAPI', 'Fundamentos de HTTP y APIs REST', 'Tutor del pre-universitario (2024)'],
      ['Teacher of Programming 3 and Programming 4', 'Backend development with Spring Boot and FastAPI', 'HTTP and REST API fundamentals', 'Pre-university course tutor (2024)'],
    ),
    tags: ['Java', 'Spring Boot', 'Python', 'FastAPI', 'Alembic', 'HTTP', L('Docencia', 'Teaching')],
  },
  {
    role: L('Tutor de Programación', 'Programming Tutor'),
    company: L('Universidad Tecnológica Nacional — Facultad Regional San Nicolás', 'Universidad Tecnológica Nacional (UTN) — San Nicolás (remote)'),
    start: L('Ago 2025', 'Aug 2025'),
    current: true,
    achievements: L(
      ['Tutor de Programación 2 y Programación 3', 'Acompañamiento en desarrollo backend con Spring Boot y FastAPI', 'Fundamentos de HTTP y APIs REST'],
      ['Tutor for Programming 2 and Programming 3', 'Guiding students through backend development with Spring Boot and FastAPI', 'HTTP and REST API fundamentals'],
    ),
    tags: ['Java', 'Spring Boot', 'Python', 'FastAPI', 'HTTP', L('Docencia', 'Teaching')],
  },
  {
    role: L('Desarrollador Backend — Don Inodoros', 'Backend Developer — Don Inodoros'),
    company: 'Freelance',
    start: 'Jun 2026',
    end: 'Jul 2026',
    achievements: L(
      ['Sistema POS multi-sucursal para una distribuidora', 'Stock por sucursal con validación transaccional', 'Módulo de usuarios con roles y sucursales', 'WebSocket con SockJS para alertas en tiempo real', 'Suite de tests de integración con MockMvc'],
      ['Multi-branch POS system for a distributor', 'Per-branch stock with transactional validation', 'User module with roles and branches', 'WebSocket with SockJS for real-time alerts', 'Integration test suite with MockMvc'],
    ),
    tags: ['Java 21', 'Spring Boot 4', 'Spring Security', 'PostgreSQL', 'Flyway', 'WebSocket', 'Docker'],
    caseStudy: localize('/proyectos/don-inodoros', lang),
  },
  {
    role: L('Desarrollador Backend — BurGame', 'Backend Developer — BurGame'),
    company: 'Freelance',
    start: 'Feb 2026',
    end: L('Abr 2026', 'Apr 2026'),
    achievements: L(
      ['Sistema de reservas online para centro de gaming', 'API REST documentada con OpenAPI y autenticación JWT', 'Integración con Mercado Pago para señas', 'Validación de disponibilidad en tiempo real', 'Panel administrativo con control de reservas'],
      ['Online booking system for a gaming venue', 'REST API documented with OpenAPI and JWT authentication', 'Mercado Pago integration for deposits', 'Real-time availability checks', 'Admin dashboard to manage bookings'],
    ),
    tags: ['Java 21', 'Spring Boot', 'JWT', 'Mercado Pago', 'PostgreSQL', 'Docker'],
    link: 'https://www.burgame.com',
    caseStudy: localize('/proyectos/burgame', lang),
  },
  {
    role: L('Desarrollador Backend — Pasta Fiorella', 'Backend Developer — Pasta Fiorella'),
    company: 'Freelance',
    start: 'Mar 2025',
    end: L('Ago 2025', 'Aug 2025'),
    achievements: L(
      ['Backend de una plataforma de pedidos online', 'API REST por capas para tienda y panel multi-sucursal', 'Pagos con Mercado Pago confirmados por webhook', 'Costo de envío calculado por distancia', 'API mock con json-server para la demo pública'],
      ['Backend for an online ordering platform', 'Layered REST API for the store and a multi-branch dashboard', 'Mercado Pago payments confirmed by webhook', 'Distance-based shipping cost', 'Mock API with json-server for the public demo'],
    ),
    tags: ['Java 17', 'Spring Boot 3', 'JPA/Hibernate', 'PostgreSQL', 'Mercado Pago', 'Docker'],
    caseStudy: localize('/proyectos/pasta-fiorella', lang),
  },
  {
    role: L('Desarrollador Backend (pasantía)', 'Backend Developer (internship)'),
    company: 'Semillero Latam',
    start: 'Jul 2023',
    end: 'Feb 2024',
    achievements: L(
      ['APIs para bolsa de trabajo', 'APIs para E-Commerce', 'Autenticación JWT y Google OAuth2', 'Algoritmos de estadísticas y reporting'],
      ['APIs for a job board', 'APIs for e-commerce', 'JWT and Google OAuth2 authentication', 'Statistics and reporting algorithms'],
    ),
    tags: ['Java', 'Spring Boot', 'JWT', 'OAuth2', 'REST APIs'],
  },
];
---

<section id="experiencia" data-side="right" class="max-w-4xl mx-auto px-4 py-12">
  <SectionHeading index="02" title={t.title} tag={t.tag} />
  <ol class="timeline ml-2 space-y-8" data-timeline data-exp-list id="exp-list">
    {experiences.map(exp => (
      <li class="relative pl-8 md:pl-10">
        <span class="timeline-dot" aria-hidden="true"></span>
        <div class="card gradient-border p-6 animate-card">
          <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-1 mb-1">
            <h3 class="text-lg font-semibold text-[var(--color-text-primary)]">{exp.role}</h3>
            <p class="font-mono text-xs text-[var(--color-text-secondary)] whitespace-nowrap">
              {exp.start} — {exp.current
                ? <span class="ml-1 px-2 py-0.5 rounded-full font-sans font-medium bg-[var(--color-highlight-soft)] text-[var(--color-highlight)]">{t.current}</span>
                : exp.end}
            </p>
          </div>
          <p class="font-medium text-[var(--color-accent)] mb-3">{exp.company}</p>
          <ul class="list-disc pl-5 marker:text-[var(--color-accent)] text-[var(--color-text-secondary)] space-y-1 mb-4">
            {exp.achievements.map(a => <li>{a}</li>)}
          </ul>
          <div class="flex flex-wrap gap-2" data-stagger>
            {exp.tags.map((tag, i) => <Tag index={i}>{tag}</Tag>)}
          </div>
          {(exp.caseStudy || exp.link) && (
            <div class="flex flex-wrap gap-x-4 gap-y-2 mt-4">
              {exp.caseStudy && (
                <a href={exp.caseStudy} class="text-sm font-medium text-[var(--color-accent)] hover:underline">
                  {t.caseStudy}<span class="sr-only"> {t.of} {exp.role.split(' — ')[1]}</span> →
                </a>
              )}
              {exp.link && (
                <a href={exp.link} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-[var(--color-accent)] hover:underline">
                  {t.site}<span class="sr-only"> {t.of} {exp.role.split(' — ')[1]}</span> ↗
                </a>
              )}
            </div>
          )}
        </div>
      </li>
    ))}
  </ol>
  <!-- Phones: only the first two roles show until this is pressed (the full list without JS) -->
  <button type="button" class="exp-more hud-btn mt-6" data-exp-more aria-expanded="false" aria-controls="exp-list">
    {t.more(experiences.length)}
  </button>
</section>

<script>
  const list = document.querySelector<HTMLElement>('[data-exp-list]');
  const more = document.querySelector<HTMLButtonElement>('[data-exp-more]');
  more?.addEventListener('click', () => {
    const open = list?.classList.toggle('is-open') ?? false;
    more.setAttribute('aria-expanded', String(open));
    more.hidden = open;
  });
</script>
