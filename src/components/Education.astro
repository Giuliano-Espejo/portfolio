---
import SectionHeading from './SectionHeading.astro';

const certifications = [
  'Introducción al Desarrollo Web II (40h)',
  'React y Spring Boot: Crea tu primera App Full Stack',
  'React.js Aprende desde Cero Absoluto hasta Trainee',
];
---

<section id="educacion" class="max-w-4xl mx-auto px-4 py-12 animate-section">
  <SectionHeading index="05" title="Educación" />
  <div class="card gradient-border p-6 mb-8">
    <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-1">
      <h3 class="text-lg font-semibold text-[var(--color-text-primary)]">Tecnicatura Universitaria en Programación</h3>
      <p class="font-mono text-xs text-[var(--color-text-secondary)]">Ago 2022 — Jul 2024</p>
    </div>
    <p class="font-medium text-[var(--color-accent)]">Universidad Tecnológica Nacional</p>
  </div>

  <h3 class="font-mono text-xs uppercase tracking-wider text-[var(--color-text-secondary)] mb-3">Certificaciones</h3>
  <ul class="divide-y divide-[var(--color-border)] border-y border-[var(--color-border)]">
    {certifications.map(cert => (
      <li class="py-3 text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:pl-2 transition-all">{cert}</li>
    ))}
  </ul>
</section>
