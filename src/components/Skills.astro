---
const skillCategories = [
  {
    title: 'Backend',
    skills: ['Java', 'Spring Boot', 'Spring Security', 'JPA/Hibernate', 'REST APIs', 'JWT', 'OAuth2', 'WebSocket'],
  },
  {
    title: 'Bases de Datos',
    skills: ['PostgreSQL', 'MySQL', 'JPA/Hibernate'],
  },
  {
    title: 'Herramientas',
    skills: ['Gradle', 'Git', 'Docker', 'MockMvc', 'SockJS'],
  },
];
---

<section id="skills" class="max-w-4xl mx-auto px-4 py-10 animate-section">
  <h2 class="text-2xl font-bold text-[var(--color-text-primary)] mb-8">Skills</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {skillCategories.map(cat => (
      <div class="card p-6 animate-card">
        <h3 class="font-semibold text-[var(--color-accent)] mb-4">{cat.title}</h3>
        <div class="flex flex-wrap gap-2">
          {cat.skills.map(skill => (
            <span class="px-3 py-1.5 bg-[var(--color-bg-primary)] font-mono text-sm text-[var(--color-text-primary)] border border-[var(--color-border)] rounded-lg">{skill}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
