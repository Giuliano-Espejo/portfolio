---
import SectionHeading from './SectionHeading.astro';
import Tag from './Tag.astro';
import { langFromLocale } from '../i18n';

const en = langFromLocale(Astro.currentLocale) === 'en';
const t = en ? { tag: 'Beacon 04 // Stack' } : { tag: 'Baliza 04 // Stack' };

// Keep in sync with Experience and src/case-studies/*.md — only list what a project or job backs up
const skillCategories = [
  {
    title: 'Backend',
    skills: ['Java 21', 'Spring Boot', 'Spring Security', 'Spring Data JPA / Hibernate', 'Bean Validation', 'MapStruct', 'REST APIs', en ? 'Microservices' : 'Microservicios', 'JWT', 'OAuth2', 'WebSocket (STOMP / SockJS)', 'Python', 'FastAPI'],
  },
  {
    title: en ? 'Databases' : 'Bases de Datos',
    skills: ['SQL', 'PostgreSQL', 'MySQL', 'H2', 'Flyway', 'Alembic', 'Hibernate Envers'],
  },
  {
    title: en ? 'Testing and quality' : 'Testing y calidad',
    skills: ['JUnit 5', 'MockMvc', 'Spring Security Test', 'TDD', 'Swagger / OpenAPI'],
  },
  {
    title: en ? 'Infrastructure and tools' : 'Infra y herramientas',
    skills: ['Docker', 'Docker Compose', 'Linux', 'Caddy', 'CI/CD', 'GitHub Actions', 'Git', 'Gradle', 'json-server'],
  },
  {
    title: en ? 'Integrations' : 'Integraciones',
    skills: ['Mercado Pago', 'Webhooks', 'Cloudinary', 'OpenRouteService', 'SMTP'],
  },
  {
    title: en ? 'Methodologies' : 'Metodologías',
    skills: ['Scrum', 'Agile', 'Code review'],
  },
];
---

<section id="skills" data-side="right" class="max-w-4xl mx-auto px-4 py-12">
  <SectionHeading index="04" title="Skills" tag={t.tag} />
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {skillCategories.map((cat, i) => (
      <div class="card gradient-border p-6 animate-card first:md:col-span-2 last:md:col-span-2">
        <h3 class="flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-[var(--color-text-secondary)] mb-4">
          <span class="h-2 w-2 rounded-full" style={`background: var(--g${(i % 3) + 1}); box-shadow: 0 0 10px var(--g${(i % 3) + 1})`} aria-hidden="true"></span>
          {cat.title}
        </h3>
        <div class="flex flex-wrap gap-2" data-stagger>
          {cat.skills.map((skill, j) => <Tag size="md" index={j}>{skill}</Tag>)}
        </div>
      </div>
    ))}
  </div>
</section>
